# ==========================================================================
# FOR WOMEN — MODELO DE VARIÁVEIS DE AMBIENTE
# --------------------------------------------------------------------------
# Copie este arquivo para ".env" e preencha os valores.
# No Windows:  copy .env.example .env
#
# A string de conexão está no painel do Supabase, em
# Project Settings > Database > Connection string > URI (Session pooler).
# Se a senha tiver caracteres especiais, troque-os pelo código:
# @ vira %40, # vira %23, $ vira %24, : vira %3A
# ==========================================================================

DATABASE_URL=postgresql://usuario:senha@host:5432/postgres

SESSION_SECRET=coloque-aqui-uma-frase-secreta

PORTA=3000
